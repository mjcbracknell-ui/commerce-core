# CommerceCore environment
# Copy to .env for local/docker use. Backend also reads backend/.env.
# Generate license keys with: npm run keys

# Core
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cc:cc@localhost:5432/commercecore
JWT_SECRET=change-me-super-long-secret-123
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# URLs / CORS (comma separated)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000

# License (RSA-2048). Paste the one-line values printed by `npm run keys`.
LICENSE_PUBLIC_KEY=
LICENSE_PRIVATE_KEY=
LICENSE_ADMIN_TOKEN=
ALLOW_DEMO_LICENSE=true

# Stripe (merchant payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Search (optional; SQL fallback when empty)
MEILI_HOST=http://localhost:7700
MEILI_KEY=masterKey123

# Redis
REDIS_URL=redis://localhost:6379

# Object storage (optional)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=commercecore
S3_ACCESS=minio
S3_SECRET=minio12345

# Email (MailHog captures local mail at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CommerceCore <no-reply@commercecore.local>
