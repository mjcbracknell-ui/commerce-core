<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title | default: shop.name }}</title>
    <style>
      :root{--paper:#f7f4ed;--ink:#161513;--muted:#6f6a61;--line:#ddd6c8;--accent:#c4502f;--serif:'Iowan Old Style',Palatino,Georgia,serif}
      *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;line-height:1.6}
      a{color:inherit;text-decoration:none}img{max-width:100%;display:block}
      .wrap{width:min(1160px,calc(100% - 40px));margin:0 auto}
      header.site{border-bottom:1px solid var(--line);position:sticky;top:0;background:rgba(247,244,237,.92);backdrop-filter:blur(10px);z-index:10}
      header.site .inner{height:70px;display:flex;align-items:center;justify-content:space-between;gap:20px}
      .brand{font-family:var(--serif);font-size:1.4rem;letter-spacing:-.02em}
      nav.main{display:flex;gap:24px;font-size:.9rem}nav.main a:hover{color:var(--accent)}
      .hero{padding:clamp(48px,8vw,100px) 0;border-bottom:1px solid var(--line);background:radial-gradient(circle at 80% 20%,#f0d9c8 0,transparent 50%)}
      .hero .eyebrow{text-transform:uppercase;letter-spacing:.2em;font-size:.68rem;color:var(--muted);margin:0 0 14px}
      .hero h1{font-family:var(--serif);font-size:clamp(2.4rem,6vw,4.2rem);line-height:1.05;letter-spacing:-.03em;margin:0 0 16px;max-width:18ch}
      .hero p.lede{max-width:48ch;color:#3c3831;margin:0 0 28px}
      .btn{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:var(--paper);padding:13px 26px;border-radius:999px;font-size:.9rem}
      .btn:hover{background:#000}
      .section{padding:clamp(40px,6vw,72px) 0}
      .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:28px}
      .section-head h2{font-family:var(--serif);font-size:clamp(1.5rem,3vw,2.2rem);font-weight:500;margin:0}
      .section-head a{font-size:.86rem;border-bottom:1px solid var(--ink)}
      .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:26px}
      .card{display:flex;flex-direction:column;gap:10px}
      .card .media{aspect-ratio:4/5;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#efeae0;display:grid;place-items:center}
      .card .media img{width:100%;height:100%;object-fit:cover}
      .card .media span{font-family:var(--serif);font-size:1.2rem;color:#7a6f5f;padding:16px;text-align:center}
      .card .title{display:flex;justify-content:space-between;gap:10px;font-size:.95rem}
      .card .title b{font-weight:500}
      .card .meta{font-size:.76rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
      .rich{padding:clamp(36px,6vw,64px) 0}
      .rich .inner{max-width:720px;text-align:center;margin:0 auto}
      .rich h2{font-family:var(--serif);font-size:clamp(1.6rem,3vw,2.4rem);font-weight:500}
      .rich p{color:var(--muted)}
      footer.site{border-top:1px solid var(--line);padding:36px 0;margin-top:20px;font-size:.82rem;color:var(--muted)}
      footer.site .inner{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
      .pdp{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;padding:56px 0}
      .pdp .media{aspect-ratio:4/5;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:#efeae0}
      .pdp .media img{width:100%;height:100%;object-fit:cover}
      .pdp h1{font-family:var(--serif);font-size:clamp(2rem,4vw,3rem);font-weight:500;margin:0 0 10px}
      .pdp .price{font-size:1.15rem;margin:0 0 20px}
      .pdp .desc{color:#47423a}
      .pdp .buy{margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}
      .pdp .stock{font-size:.8rem;color:var(--muted)}
      .badge{display:inline-block;font-size:.66rem;text-transform:uppercase;letter-spacing:.1em;background:#fff;border:1px solid var(--line);border-radius:999px;padding:3px 9px;margin-bottom:8px}
      @media(max-width:800px){.pdp{grid-template-columns:1fr}nav.main{display:none}}
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap inner">
        <a class="brand" href="/">{{ shop.name }}</a>
        <nav class="main">
          <a href="/collections/all">Shop</a>
          <a href="/collections">Collections</a>
          <a href="/search">Search</a>
          <a href="/cart">Cart ({{ cart.item_count | default: 0 }})</a>
        </nav>
      </div>
    </header>

    <main>{{ content_for_layout }}</main>

    <footer class="site">
      <div class="wrap inner">
        <span>© {{ shop.name }} — {{ shop.currency }} store</span>
        <span>Powered by Commerce Core · perpetual license</span>
      </div>
    </footer>
  </body>
</html>
